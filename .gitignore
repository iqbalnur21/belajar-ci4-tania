#--------------------------------------------------
# CodeIgniter 4 .gitignore
#--------------------------------------------------

# Environment Files (Do not commit sensitive credentials)
.env
.vagrant
Vagrantfile

# Composer Dependencies
/vendor/
composer.phar

# CodeIgniter 4 Writable Files
/writable/cache/*
!/writable/cache/index.html
/writable/debugbar/*
!/writable/debugbar/index.html
/writable/logs/*
!/writable/logs/index.html
/writable/session/*
!/writable/session/index.html
/writable/uploads/*
!/writable/uploads/index.html

php_errors.log

# Testing & Coverage
/tests/coverage*
/phpunit
.phpunit.result.cache
/phpunit.xml
/results/

# User Guide Temp Files
/user_guide_src/build/*
/user_guide_src/cilexer/build/*
/user_guide_src/cilexer/dist/*
/user_guide_src/cilexer/pycilexer.egg-info/*

# Operating System Files
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk
*~
.directory
.Trash-*

# IDE & Editor Files
.vscode/
.idea/
*.iml
/nbproject/
/build/
/nbbuild/
/dist/
/nbdist/
/nbactions.xml
/nb-configuration.xml
/.nb-gradle/
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
*.sublime-project
.phpintel
/api/
.php-version
_modules/*
